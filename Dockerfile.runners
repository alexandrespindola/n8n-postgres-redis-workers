FROM n8nio/runners:latest

USER root

# Bibliotecas JS essenciais para o Code Node (sem Puppeteer/Playwright)
RUN cd /opt/runners/task-runner-javascript && pnpm add \
    node-fetch \
    axios \
    cheerio \
    jsdom \
    xpath \
    tough-cookie \
    moment \
    moment-timezone \
    lodash \
    uuid \
    validator \
    date-fns \
    jsonpath \
    joi \
    form-data \
    @faker-js/faker \
    ms \
    xml2js \
    csv-parse \
    pdf-parse \
    sharp \
    openai \
    @anthropic-ai/sdk

# Configuração do launcher (allowlist de módulos)
COPY --chown=runner:runner n8n-task-runners.json /etc/n8n-task-runners.json

USER runner
