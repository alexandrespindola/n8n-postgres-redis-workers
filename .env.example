# n8n config
N8N_PROTOCOL=https
N8N_HOST=[host] # type your n8n host here or IP address
N8N_ENCRYPTION_KEY=[encryption_key] # generate a character long key
N8N_RUNNERS_ENABLED=true
N8N_RUNNERS_MODE=internal
NODE_ENV=production
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true

# Optional timezone to set which gets used by Cron-Node by default
# If not set New York time will be used
GENERIC_TIMEZONE=[timezone] # e.g. Europe/Berlin

# Postgres config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=[postgres_password] # type your postgres password here
POSTGRES_DB=[database_name] # type your project name here, example: n8n_myproject
POSTGRES_NON_ROOT_USER=n8n_user
POSTGRES_NON_ROOT_PASSWORD=[non_root_password] # type your non-root postgres password here

# Project name
COMPOSE_PROJECT_NAME=[project_name] # type your project name here